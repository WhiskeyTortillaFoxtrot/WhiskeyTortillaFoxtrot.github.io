---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import LeagueTicker from '../components/LeagueTicker.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<BaseLayout title="Home">
  <!-- Hero -->
  <section class="hero">
    <div class="container text-center">
      <h1 class="hero__title">Whiskey Tortilla Foxtrot</h1>
      <p class="hero__tagline">Building apps for sports fans.</p>
      <div class="hero__actions">
        <a href="#seenat" class="btn btn--primary">See Our Apps</a>
        <a href={`${base}about/`} class="btn btn--outline">About Us</a>
      </div>
    </div>
  </section>

  <LeagueTicker />

  <!-- Company Intro -->
  <section class="section reveal">
    <div class="container text-center" style="max-width: 680px;">
      <p class="company-intro">
        Whiskey Tortilla Foxtrot is an independent software studio building tools
        for sports fans who want to remember every game-day moment. We care about
        the little details — the jersey in row 12, the retired number on the
        outfield wall, the obscure sleeve patch.
      </p>
    </div>
  </section>

  <!-- Featured Product: SeenAt -->
  <section id="seenat" class="section section--alt reveal">
    <div class="container">
      <div class="featured">
        <div class="featured__content">
          <span class="badge">Coming Soon</span>
          <h2 style="margin: 1rem 0 0.75rem;">SeenAt</h2>
          <p class="featured__tagline">Track every jersey you've Seen At the game.</p>
          <p class="featured__desc text-secondary">
            Log jerseys you spot at live sporting events, track which teams and
            players you see most, and relive your game-day memories through
            photos and stats.
          </p>
          <div class="featured__actions">
            <a href={`${base}seenat/`} class="btn btn--primary">Learn More</a>
          </div>
        </div>
        <div class="featured__preview">
          <PhoneFrame src={`${base}screenshots/HomeView.png`} alt="SeenAt home screen" />
        </div>
      </div>

      <div class="grid grid--3" style="margin-top: 3rem;">
        <FeatureCard
          title="Live Tracking"
          description="Log jerseys in real time with Live Activities on Dynamic Island and Lock Screen."
          icon="activity"
        />
        <FeatureCard
          title="Stats Dashboard"
          description="See which teams and players you spot most with interactive bar and pie charts."
          icon="stats"
        />
        <FeatureCard
          title="6 Leagues"
          description="MLB, NBA, NFL, NHL, LOVB, and MLS — 158 built-in teams and counting."
          icon="leagues"
        />
      </div>
    </div>
  </section>

  <hr class="divider-stitch" />

  <!-- CTA -->
  <section class="section text-center">
    <div class="container">
      <h2>More coming soon.</h2>
      <p class="text-secondary" style="margin: 1rem 0 2rem;">
        We're always building something new for sports fans.
      </p>
      <a href={`${base}about/`} class="btn btn--outline">About Us</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 6rem 0 3rem;
  }
  .hero__title {
    margin: 0 0 0.5rem;
    background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 60%, #fff));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero__tagline {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }
  .hero__actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }
  .company-intro {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .featured {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .featured__tagline {
    font-size: 1.15rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }
  .featured__desc {
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  .featured__preview {
    display: flex;
    justify-content: center;
  }
  @media (max-width: 768px) {
    .featured {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .featured__actions {
      justify-content: center;
    }
  }
</style>
