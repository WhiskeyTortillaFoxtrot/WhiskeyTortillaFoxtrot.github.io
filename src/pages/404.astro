---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<BaseLayout title="Page Not Found">
  <section class="section not-found">
    <div class="container text-center">
      <span class="not-found__code">404</span>
      <h1 class="not-found__title">Wrong stadium.</h1>
      <p class="text-secondary not-found__desc">
        This page hasn't been spotted yet.<br />
        Head back to the home field.
      </p>
      <a href={base} class="btn btn--primary" style="margin-top: 2rem;">Back to Home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
  }
  .not-found__code {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: clamp(5rem, 15vw, 10rem);
    font-weight: 900;
    line-height: 1;
    color: var(--accent);
    opacity: 0.2;
  }
  .not-found__title {
    margin: 0.5rem 0 1rem;
  }
  .not-found__desc {
    font-size: 1.1rem;
    line-height: 1.6;
  }
</style>
